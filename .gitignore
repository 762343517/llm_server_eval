# 评测/压测任务的运行数据（含结果文件与明文密钥的 last_config）
runs/*

# 数据集：数据文件与目录不入库（体积大、来源各异）；只有清单与字段映射配置入库
dataset/*
!dataset/datasets.json

# 本地放置的分词器 / 模型权重（体积大，不入库）
model/*
# 但对话模板需要入库：evalscope 用它在客户端估算 prompt token 数，缺了会直接报错
!model/GLM-5.3/
model/GLM-5.3/*
!model/GLM-5.3/chat_template.jinja

# Python
__pycache__/
*.py[cod]

# 前端依赖与本地构建缓存
frontend/node_modules/
frontend/.vite/
frontend/dist/
.venv

dist/*

build/*

# 前端构建产物由 FastAPI 托管，如需部署到无 Node 环境的机器可直接提交；
# 若团队约定不提交产物，取消下面一行注释即可。
# backend/webui/
