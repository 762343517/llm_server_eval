{
  "version": 1,
  "default": "SimpleQA-Verified",
  "datasets": [
    {
      "name": "SimpleQA-Verified",
      "title": "SimpleQA-Verified",
      "reader": "csv",
      "file": "simpleqa_verified.csv",
      "fields": {
        "problem": "problem",
        "answer": "answer",
        "topic": "topic",
        "answer_type": "answer_type",
        "subject": "subject"
      }
    },
    {
      "name": "HLE",
      "title": "HLE (Humanity's Last Exam)",
      "reader": "hle",
      "file": "*.parquet",
      "fields": {
        "problem": "question",
        "answer": "answer",
        "topic": "category",
        "answer_type": "answer_type",
        "subject": "raw_subject",
        "image": "image"
      }
    },
    {
      "name": "deepswe",
      "title": "DeepSWE",
      "reader": "parquet",
      "file": "data/*.parquet",
      "fields": {
        "problem": "problem_statement",
        "topic": "category",
        "subject": "language"
      },
      "runnable": false,
      "note": "SWE 类编码 agent 任务：在「Agent 评测」页发起（pier + docker 逐任务沙箱判定），不走单轮作答 + 裁判判分流程",
      "agent": {
        "framework": "pier",
        "tasks": "tasks"
      }
    }
  ]
}